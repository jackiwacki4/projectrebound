# Copy to .env (which is gitignored) and fill in.
# NEVER commit real credentials. NEVER paste the private key inline here --
# only its file path.

# From kalshi.com/account/profile -> API Keys. The private key PEM is shown
# once at creation; save the file and point KALSHI_PRIVATE_KEY_PATH at it.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# demo = Kalshi sandbox (fake money). prod = real markets / real account.
# Micro-live trading is ALSO gated by a hand-set flag in the YAML config;
# setting this to prod alone does not place any orders.
KALSHI_ENVIRONMENT=demo
