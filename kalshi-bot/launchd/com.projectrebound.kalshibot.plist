<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent to run the collector 24/7 and restart it on crash.

  Install (see README for the full walkthrough):
    1. Edit the paths below: replace /Users/YOU/projectrebound/kalshi-bot with
       your real path (run `pwd` inside the kalshi-bot folder to see it).
       To run the SPORTS family instead, point --config at config/sports.yaml
       and give this file a different Label, so the two can run side by side.
    2. cp launchd/com.projectrebound.kalshibot.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.projectrebound.kalshibot.plist
    4. launchctl start com.projectrebound.kalshibot

  KeepAlive restarts the process if it exits. `caffeinate -s` (below) keeps the
  Mac awake while on power so collection is not interrupted by sleep -- see the
  README for the battery/thermal tradeoff.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.projectrebound.kalshibot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
        <!-- The .venv interpreter, NOT the system python3: setup.sh installs the
             libraries into .venv, and `/usr/bin/env python3` would crash-loop
             here on a missing PyYAML (KeepAlive restarts it every 30s forever). -->
        <string>/Users/YOU/projectrebound/kalshi-bot/.venv/bin/python</string>
        <string>-m</string>
        <string>kalshibot.cli</string>
        <string>run</string>
        <string>--config</string>
        <string>/Users/YOU/projectrebound/kalshi-bot/config/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOU/projectrebound/kalshi-bot</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/YOU/projectrebound/kalshi-bot/src</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOU/projectrebound/kalshi-bot/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/projectrebound/kalshi-bot/logs/launchd.err.log</string>

    <!-- Give the process a moment between restarts rather than spinning. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
