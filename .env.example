# --- Kalshi connection ---
# demo = Kalshi's own sandbox (fake money, safe to hammer on).
# production = real market data / real order books.
KALSHI_ENVIRONMENT=demo

# From https://kalshi.com/account/profile -> API Keys. The private key is
# shown ONCE at creation time -- save the PEM file immediately.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# --- Trading mode (independent of KALSHI_ENVIRONMENT) ---
# paper = this bot simulates fills locally against real order-book prices;
#         no order is ever sent to Kalshi. Safe with either environment above.
# live  = orders are actually submitted to Kalshi. Requires
#         LIVE_TRADING_CONFIRMED=true below as a second, explicit switch.
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# --- Paper portfolio ---
STARTING_CASH_CENTS=100000

# --- Risk limits (all in cents) ---
MAX_POSITION_CENTS=5000
MAX_EVENT_EXPOSURE_CENTS=20000
MAX_DAILY_LOSS_CENTS=10000
MAX_ORDERS_PER_MINUTE=20

# --- Scanning ---
MARKET_POLL_INTERVAL_MS=15000
MIN_ARB_EDGE_CENTS=1
NEWS_POLL_INTERVAL_MS=30000
# Comma-separated RSS feed URLs.
NEWS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://feeds.bbci.co.uk/news/rss.xml

LOG_LEVEL=info

# --- Dashboard (optional) ---
# Set both to enable the monitoring dashboard. It always binds to
# DASHBOARD_HOST (localhost by default) -- see README "Dashboard" section
# for how to reach it remotely without opening a port on your router.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_PORT=4173
DASHBOARD_HOST=127.0.0.1
